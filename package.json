{
  "name": "opencode-side-panel-sessions",
  "version": "0.2.0",
  "description": "OpenCode TUI plugin that displays parallel/background agent sessions in the sidebar with live status, pinning, and one-click navigation",
  "type": "module",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "main": "dist/tui.js",
  "types": "dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "oc-plugin": [
    "tui"
  ],
  "files": [
    "dist",
    "tui.tsx",
    "scripts/register-tui.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/register-tui.mjs",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/solid": "^0.5.17",
    "@opentui/core": "^0.5.17",
    "solid-js": "^1.9.12"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.26"
  },
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "sidebar",
    "sessions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-marcon/opencode-side-panel-sessions.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
