{
  "name": "opencode-side-panel-sessions",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin that displays parallel/background agent sessions in the sidebar with live status, pinning, and one-click navigation",
  "type": "module",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "main": "dist/tui.js",
  "types": "dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "oc-plugin": ["tui"],
  "files": ["dist", "scripts/register-tui.mjs", "README.md", "LICENSE"],
  "scripts": {
    "postinstall": "node scripts/register-tui.mjs",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/solid": "^0.2.8",
    "@opentui/core": "^0.2.8",
    "solid-js": "^1.9.12"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "@opencode-ai/sdk": "^1.16.2"
  },
  "keywords": ["opencode", "plugin", "tui", "sidebar", "sessions"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-marcon/opencode-side-panel-sessions.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
